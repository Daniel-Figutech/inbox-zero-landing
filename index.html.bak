<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Inbox Zero is Actually Possible.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Pixelify+Sans:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

  :root{
    /* 1 unit = 1% of the 1993px reference width, locked above that */
    --k: min(1vw, 19.93px);

    --bg:        #141414;
    --grid:      rgba(255,255,255,.030);

    --mono-a:    #9a9a9a;
    --mono-b:    #8c8c8c;
  }

  html,body{height:100%}

  body{
    background: var(--bg);
    font-family:'Space Grotesk',system-ui,sans-serif;
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
    min-height:100dvh;
    display:grid;
    place-items:center;
    overflow-x:hidden;
  }

  /* ── background: column grid + soft centre glow ───────────────── */
  .bg{
    position:fixed; inset:0; z-index:0; pointer-events:none;
  }
  .bg::before{
    content:''; position:absolute; inset:0;
    background-image:linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size:6.25% 100%;
    -webkit-mask-image:linear-gradient(180deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,1) 22%,rgba(0,0,0,1) 72%,rgba(0,0,0,.35) 100%);
            mask-image:linear-gradient(180deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,1) 22%,rgba(0,0,0,1) 72%,rgba(0,0,0,.35) 100%);
  }
  .bg::after{
    content:''; position:absolute; inset:0;
    background:radial-gradient(58% 42% at 50% 34%, rgba(255,255,255,.045) 0%, rgba(255,255,255,0) 70%);
  }

  /* ── stage ────────────────────────────────────────────────────── */
  .stage{
    position:relative; z-index:1;
    width:100%;
    display:flex; flex-direction:column; align-items:center;
    padding: calc(var(--k) * 5.5) 0 calc(var(--k) * 3.5);
  }

  /* ── headline ─────────────────────────────────────────────────── */
  /*
     CHROME MATERIAL — two stacked background layers, blended, then clipped to
     the glyphs. Layer 1 (top) is the per-glyph vertical BEVEL. Layer 2 (bottom)
     is the per-line horizontal SHEEN. They are combined with `hard-light`,
     whose branch is chosen by the SOURCE (= the bevel, the top layer):
        bevel > 0.5  ->  screen(bevel, sheen)   highlights survive any column
        bevel <= 0.5 ->  multiply(bevel, sheen) shadows deepen in dark columns
     That is what the reference does: the x-height rim reads 243-255 even in the
     darkest column, while the mid-tones swing 110 -> 195 across the line.

     Putting the BEVEL on top is also the safety net: if a browser drops
     background-blend-mode under background-clip:text, the opaque top layer
     simply wins and the headline degrades to a correct vertical chrome.

     Vertical mapping. Space Grotesk at line-height 1.05 puts the baseline at
     0.8725em and the cap top at 0.1725em from the top of the line box. The line
     gets 0.12em of block padding (cancelled by an equal negative margin, so the
     layout is untouched) purely to give the background box room for the "y"
     descender and for the drop shadow. Inside that 1.29em-tall box:
        cap top   0.2925em -> 22.67 %
        x-height  0.5000em -> 38.76 %   (rim peak placed a hair above, 38.1 %)
        baseline  0.9925em -> 76.94 %
     so the ramp carries TWO bright rims - one for tall letters, one at the
     x-line for s/c/u/a/y/o - and a hard fall to the dark bottom edge.
  */
  h1{
    font-weight:500;
    font-size: calc(var(--k) * 7.2);
    line-height:1.05;
    letter-spacing:-0.005em;
    text-align:center;

    /* flex, so the negative block margins on the lines cannot collapse and the
       lines shrink-wrap the text (the sheen must span the GLYPHS, not the page) */
    display:flex;
    flex-direction:column;
    align-items:center;

    --bevel:linear-gradient(180deg,
      #fafafa   0%,      /* holds above the cap line: i-dots, pixel-font caps */
      #fafafa  22.67%,   /* cap top — tall-letter rim */
      #f0f0f0  25.11%,
      #d6d6d6  27.29%,
      #bababa  30.81%,
      #a6a6a6  34.07%,   /* shelf: the dip that lets the x-rim read as an edge */
      #acacac  35.42%,
      #fefefe  38.14%,   /* x-height rim — the brightest band in the line */
      #ececec  40.31%,
      #d0d0d0  44.38%,
      #b6b6b6  49.81%,
      #aaaaaa  55.23%,
      #bababa  59.57%,   /* satin bounce lobe */
      #a8a8a8  63.91%,
      #8a8a8a  69.34%,
      #686868  73.14%,
      #484848  76.11%,
      #3c3c3c  76.94%,   /* baseline — dark bottom edge */
      #303030  80.19%,
      #2c2c2c  93.21%,   /* descender of the "y" */
      #2c2c2c 100%);

    /* neutral default so background-image can never fail to resolve */
    --sheen:linear-gradient(90deg,#808080 0%,#808080 100%);
  }

  h1 .line{
    display:block;
    /* Layer model, measured not eyeballed:
         layer 1 = per-glyph bevel, authored around 128-grey, blended hard-light
         layer 2 = per-line horizontal sheen, carries the absolute luminance
       Space Grotesk @ line-height 1.05 -> cap top = 17.0% of the line box,
       x-height top = 34.2%, baseline = 83.7%. The bright stops at 17% AND 34.2%
       are what give tall glyphs AND x-height glyphs each their own top rim —
       a single line-spanning gradient cannot do that. */
    --bevel:linear-gradient(180deg,
      #b9b9b9  0%,
      #b9b9b9 17.0%,
      #dfdfdf 19.7%,
      #898989 25.0%,
      #797979 32.6%,
      #dfdfdf 34.2%,
      #a6a6a6 39.0%,
      #797979 49.0%,
      #6c6c6c 58.4%,
      #898989 66.4%,
      #737373 75.7%,
      #4f4f4f 83.7%,
      #4f4f4f 100%);
    background-blend-mode:hard-light, normal;
    -webkit-background-clip:text;
            background-clip:text;
    color:transparent;
    filter:
      drop-shadow(0 calc(var(--k) * .07) 0 rgba(0,0,0,.55))
      drop-shadow(0 calc(var(--k) * .6) calc(var(--k) * 1.6) rgba(0,0,0,.5));
  }
  h1 .l1{ background-image:var(--bevel),
    linear-gradient(90deg,#4d4d4d 0%,#5f5f5f 8%,#878787 20%,#adadad 32%,#c8c8c8 44%,
                          #9d9d9d 54%,#b4b4b4 64%,#7d7d7d 76%,#5c5c5c 88%,#4a4a4a 100%); }
  h1 .l2{ background-image:var(--bevel),
    linear-gradient(90deg,#c6c6c6 0%,#b6b6b6 10%,#949494 24%,#6c6c6c 38%,#5b5b5b 50%,
                          #4b4b4b 60%,#4a4a4a 68%,#565656 78%,#6a6a6a 88%,#949494 100%); }
  h1 .l3{ background-image:var(--bevel),
    linear-gradient(90deg,#4c4c4c 0%,#4c4c4c 10%,#5e5e5e 24%,#767676 36%,#969696 48%,
                          #a5a5a5 58%,#b8b8b8 68%,#c8c8c8 78%,#c2c2c2 88%,#9d9d9d 100%); }

  /* the glitched, bitmap-set characters */
  h1 .px{
    font-family:'Pixelify Sans','Space Grotesk',sans-serif;
    font-weight:600;
    font-size:1.045em;
    letter-spacing:-0.012em;
  }

  /* ── envelope ─────────────────────────────────────────────────── */
  .envelope{
    width: calc(var(--k) * 27.75);
    height:auto;
    display:block;
    margin-top: calc(var(--k) * 3.1);
    filter:drop-shadow(0 calc(var(--k) * 1.2) calc(var(--k) * 2.2) rgba(0,0,0,.65));
  }

  /* ── waitlist bar ─────────────────────────────────────────────── */
  .bar{
    position:relative;
    width: calc(var(--k) * 47.4);
    max-width:calc(100% - var(--k) * 6);
    height: calc(var(--k) * 6.87);
    margin-top: calc(var(--k) * -4.1);
    display:flex; align-items:center;
    padding-left:  calc(var(--k) * 2.5);
    padding-right: calc(var(--k) * 3.6);
    border:1px solid rgba(255,255,255,.22);
    border-radius: calc(var(--k) * .22);
    background:linear-gradient(180deg,#191919 0%,#131313 55%,#0d0d0d 100%);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.05),
      0 calc(var(--k) * 3) calc(var(--k) * 6) calc(var(--k) * -1) rgba(0,0,0,.9),
      0 calc(var(--k) * .8) calc(var(--k) * 2.2) rgba(0,0,0,.75);
  }
  .bar::after{ /* soft pooled shadow under the bar */
    content:''; position:absolute; left:4%; right:4%;
    bottom: calc(var(--k) * -2.2); height: calc(var(--k) * 4);
    background:radial-gradient(50% 100% at 50% 0%, rgba(0,0,0,.85), rgba(0,0,0,0) 72%);
    z-index:-1; pointer-events:none;
  }

  .bar input,
  .bar button{
    font-family:'Space Mono',ui-monospace,monospace;
    font-size: calc(var(--k) * 1.5);
    letter-spacing:.1em;
    background:none; border:0; outline:none; padding:0;
  }
  .bar input{
    flex:1 1 auto; min-width:0;
    color:#e6e6e6;
    caret-color:#cfcfcf;
  }
  .bar input::placeholder{ color:var(--mono-a); opacity:1 }
  .bar button{
    flex:0 0 auto;
    color:var(--mono-b);
    cursor:pointer;
    white-space:nowrap;
    transition:color .22s ease;
  }
  .bar button:hover,
  .bar button:focus-visible{ color:#e8e8e8 }

  .bar.is-done{ justify-content:center; padding-inline:calc(var(--k) * 2.5) }
  .bar.is-done .done{
    font-family:'Space Mono',ui-monospace,monospace;
    font-size: calc(var(--k) * 1.5);
    letter-spacing:.1em;
    color:var(--mono-a);
  }

  /* ── small screens: same design, scaled up to fill the phone ──── */
  @media (max-width: 820px){
    :root{ --k: 1.62vw }
  }
  @media (max-width: 560px){
    :root{ --k: 1.95vw }
  }

  @media (prefers-reduced-motion: reduce){
    *{transition:none !important; animation:none !important}
  }
</style>
</head>
<body>

<div class="bg" aria-hidden="true"></div>

<main class="stage">

  <h1>
    <span class="line l1"><span>Inb</span><span class="px">o</span><span>x&nbsp;Z</span><span class="px">e</span><span class="px">r</span><span>o</span></span>
    <span class="line l2"><span>is&nbsp;</span><span class="px">A</span><span>ctu</span><span class="px">a</span><span>lly</span></span>
    <span class="line l3"><span>Po</span><span class="px">ss</span><span>i</span><span>bl</span><span class="px">e</span><span class="px">.</span></span>
  </h1>

  <svg class="envelope" viewBox="0 0 553 355" role="img" aria-label="Envelope with a zero badge">
    <defs>
      <linearGradient id="body" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0"    stop-color="#cfcfcf"/>
        <stop offset=".30"  stop-color="#b3b3b3"/>
        <stop offset=".62"  stop-color="#929292"/>
        <stop offset="1"    stop-color="#6a6a6a"/>
      </linearGradient>
      <radialGradient id="wedge" cx=".22" cy=".78" r=".7">
        <stop offset="0"   stop-color="rgba(255,255,255,.16)"/>
        <stop offset="1"   stop-color="rgba(255,255,255,0)"/>
      </radialGradient>
      <linearGradient id="flap" x1=".08" y1="0" x2=".92" y2=".95">
        <stop offset="0"    stop-color="#c2c2c2"/>
        <stop offset=".42"  stop-color="#a0a0a0"/>
        <stop offset="1"    stop-color="#7d7d7d"/>
      </linearGradient>
      <linearGradient id="edge" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0"   stop-color="rgba(255,255,255,.55)"/>
        <stop offset=".5"  stop-color="rgba(255,255,255,.10)"/>
        <stop offset="1"   stop-color="rgba(0,0,0,.45)"/>
      </linearGradient>
      <!-- ══ BADGE MATERIAL ══════════════════════════════════════════════════
           Light: key from upper-left / upper-centre, weak rim from lower-right.
           All gradients are userSpaceOnUse (viewBox units) — most portable form,
           and immune to Safari's objectBoundingBox-on-stroke quirks.
           All filters declare color-interpolation-filters="sRGB": without it
           Chrome and Safari blur in linearRGB and the aura renders visibly
           milkier / larger in one than the other. -->

      <!-- blur kit. stdDeviation is in viewBox units (primitiveUnits defaults
           to userSpaceOnUse), so every glow scales with the page. -->
      <filter id="izBlurXS" x="-150%" y="-150%" width="400%" height="400%"
              color-interpolation-filters="sRGB" primitiveUnits="userSpaceOnUse">
        <feGaussianBlur stdDeviation="1.1"/>
      </filter>
      <filter id="izBlurS" x="-150%" y="-150%" width="400%" height="400%"
              color-interpolation-filters="sRGB" primitiveUnits="userSpaceOnUse">
        <feGaussianBlur stdDeviation="3.4"/>
      </filter>
      <filter id="izBlurM" x="-150%" y="-150%" width="400%" height="400%"
              color-interpolation-filters="sRGB" primitiveUnits="userSpaceOnUse">
        <feGaussianBlur stdDeviation="10"/>
      </filter>
      <filter id="izBlurL" x="-180%" y="-180%" width="460%" height="460%"
              color-interpolation-filters="sRGB" primitiveUnits="userSpaceOnUse">
        <feGaussianBlur stdDeviation="20"/>
      </filter>
      <filter id="izBlurContact" x="-80%" y="-80%" width="260%" height="260%"
              color-interpolation-filters="sRGB" primitiveUnits="userSpaceOnUse">
        <feGaussianBlur stdDeviation="7"/>
      </filter>
      <filter id="izBlurContactTight" x="-80%" y="-80%" width="260%" height="260%"
              color-interpolation-filters="sRGB" primitiveUnits="userSpaceOnUse">
        <feGaussianBlur stdDeviation="2.6"/>
      </filter>

      <!-- outer bezel: near-black, glossy, lit down-right -->
      <linearGradient id="izBezel" gradientUnits="userSpaceOnUse" x1="351" y1="60" x2="457" y2="166">
        <stop offset="0"   stop-color="#1b1b1b"/>
        <stop offset=".38" stop-color="#0d0d0d"/>
        <stop offset=".72" stop-color="#060606"/>
        <stop offset="1"   stop-color="#020202"/>
      </linearGradient>
      <!-- bezel gloss, inner shoulder, top-left → fades out both ends -->
      <linearGradient id="izGlossTL" gradientUnits="userSpaceOnUse" x1="341.65" y1="83.92" x2="466.35" y2="83.92">
        <stop offset="0"   stop-color="#ffffff" stop-opacity="0"/>
        <stop offset=".28" stop-color="#ffffff" stop-opacity=".26"/>
        <stop offset=".52" stop-color="#ffffff" stop-opacity=".20"/>
        <stop offset="1"   stop-color="#ffffff" stop-opacity="0"/>
      </linearGradient>
      <!-- bezel rim-light, outer shoulder, lower-right (the weak second light) -->
      <linearGradient id="izGlossBR" gradientUnits="userSpaceOnUse" x1="473.16" y1="138.17" x2="334.84" y2="138.17">
        <stop offset="0"   stop-color="#ffffff" stop-opacity="0"/>
        <stop offset=".14" stop-color="#ffffff" stop-opacity=".30"/>
        <stop offset=".46" stop-color="#ffffff" stop-opacity=".17"/>
        <stop offset="1"   stop-color="#ffffff" stop-opacity="0"/>
      </linearGradient>

      <!-- face: soft diagonal sheen, never flat black -->
      <linearGradient id="izFace" gradientUnits="userSpaceOnUse" x1="358" y1="67" x2="450" y2="159">
        <stop offset="0"   stop-color="#1e1e1e"/>
        <stop offset=".34" stop-color="#161616"/>
        <stop offset=".70" stop-color="#0c0c0c"/>
        <stop offset="1"   stop-color="#070707"/>
      </linearGradient>
      <!-- broad low-lying sheen band across the face (measured: +12/255 lift) -->
      <linearGradient id="izSheen" gradientUnits="userSpaceOnUse" x1="338" y1="113" x2="470" y2="113">
        <stop offset="0"   stop-color="#ffffff" stop-opacity="0"/>
        <stop offset=".5"  stop-color="#ffffff" stop-opacity=".055"/>
        <stop offset="1"   stop-color="#ffffff" stop-opacity="0"/>
      </linearGradient>

      <!-- inner rim. A true conic/angular gradient does not exist in SVG (and a
           CSS conic-gradient cannot paint an SVG stroke in Safari), so the
           around-the-circumference fade is built from a linear gradient laid on
           the 140°→320° axis of the ring — a circle stroked with a linear ramp
           reads as an angular fade, bright upper-left, dark lower-right — plus
           one short overlaid arc for the lower-right second light. Portable to
           every engine, no masks, no blend modes. -->
      <linearGradient id="izRim" gradientUnits="userSpaceOnUse" x1="353.9" y1="70.96" x2="454.1" y2="155.04">
        <stop offset="0"   stop-color="#ffffff"/>
        <stop offset=".18" stop-color="#e9e9e9"/>
        <stop offset=".42" stop-color="#9b9b9b"/>
        <stop offset=".68" stop-color="#4a4a4a"/>
        <stop offset="1"   stop-color="#1a1a1a"/>
      </linearGradient>
      <linearGradient id="izRimBR" gradientUnits="userSpaceOnUse" x1="468.41" y1="124.36" x2="426.37" y2="174.46">
        <stop offset="0"   stop-color="#dfe6ea" stop-opacity="0"/>
        <stop offset=".45" stop-color="#f2f5f7" stop-opacity=".78"/>
        <stop offset="1"   stop-color="#dfe6ea" stop-opacity="0"/>
      </linearGradient>

      <!-- the "0": body, then the two bevel edges, then the lower-right spec -->
      <linearGradient id="izChrome" gradientUnits="userSpaceOnUse" x1="386" y1="76" x2="424" y2="152">
        <stop offset="0"   stop-color="#fbfbfb"/>
        <stop offset=".16" stop-color="#e4e4e4"/>
        <stop offset=".40" stop-color="#b2b2b2"/>
        <stop offset=".58" stop-color="#8d8d8d"/>
        <stop offset=".78" stop-color="#adadad"/>
        <stop offset="1"   stop-color="#6e6e6e"/>
      </linearGradient>
      <linearGradient id="izBevelOut" gradientUnits="userSpaceOnUse" x1="404" y1="75.5" x2="404" y2="150.5">
        <stop offset="0"   stop-color="#ffffff"/>
        <stop offset=".30" stop-color="#f2f2f2"/>
        <stop offset=".62" stop-color="#b6b6b6"/>
        <stop offset=".85" stop-color="#8d8d8d"/>
        <stop offset="1"   stop-color="#c6c6c6"/>
      </linearGradient>
      <linearGradient id="izBevelIn" gradientUnits="userSpaceOnUse" x1="377.5" y1="88" x2="430.5" y2="140">
        <stop offset="0"   stop-color="#ffffff"/>
        <stop offset=".30" stop-color="#e0e0e0"/>
        <stop offset=".65" stop-color="#9a9a9a"/>
        <stop offset="1"   stop-color="#6d6d6d"/>
      </linearGradient>
      <linearGradient id="izSpecBR" gradientUnits="userSpaceOnUse" x1="428.9" y1="125.83" x2="412.19" y2="148.66">
        <stop offset="0"   stop-color="#ffffff" stop-opacity="0"/>
        <stop offset=".5"  stop-color="#ffffff" stop-opacity=".92"/>
        <stop offset="1"   stop-color="#ffffff" stop-opacity="0"/>
      </linearGradient>

      <!-- aura tint: cool white, dimmer at the bottom so the glow obeys the key
           light instead of reading as a flat blurred duplicate -->
      <linearGradient id="izGlow" gradientUnits="userSpaceOnUse" x1="404" y1="70" x2="404" y2="156">
        <stop offset="0"   stop-color="#ffffff"/>
        <stop offset=".35" stop-color="#eef4f8"/>
        <stop offset=".72" stop-color="#bccbd5"/>
        <stop offset="1"   stop-color="#7d8f9b"/>
      </linearGradient>

      <radialGradient id="izDot" gradientUnits="userSpaceOnUse" cx="404" cy="113" r="6.4">
        <stop offset="0"   stop-color="#f4f4f4" stop-opacity=".92"/>
        <stop offset=".34" stop-color="#d4d4d4" stop-opacity=".78"/>
        <stop offset=".66" stop-color="#8f8f8f" stop-opacity=".40"/>
        <stop offset="1"   stop-color="#8f8f8f" stop-opacity="0"/>
      </radialGradient>

      <clipPath id="izFaceClip">
        <circle cx="404" cy="113" r="64.4"/>
      </clipPath>
      <clipPath id="izZeroClip">
        <path clip-rule="evenodd" fill-rule="evenodd"
              d="M377.5 113A26.5 37.5 0 1 0 430.5 113A26.5 37.5 0 1 0 377.5 113ZM386.5 113A17.5 28.5 0 1 0 421.5 113A17.5 28.5 0 1 0 386.5 113Z"/>
      </clipPath>
      <clipPath id="shell">
        <rect x="0" y="0" width="553" height="355" rx="16" ry="16"/>
      </clipPath>
    </defs>

    <!-- body -->
    <rect x="0" y="0" width="553" height="355" rx="16" ry="16" fill="url(#body)"/>

    <g clip-path="url(#shell)">
      <rect x="0" y="0" width="553" height="355" fill="url(#wedge)"/>
      <!-- flap -->
      <path d="M0 0 L276.5 222 L553 0 Z" fill="url(#flap)"/>
      <!-- fold shadow, then the bright crease on top of it -->
      <path d="M0 5 L276.5 227 L553 5" fill="none" stroke="rgba(0,0,0,.28)" stroke-width="6" stroke-linejoin="round"/>
      <path d="M0 0 L276.5 222 L553 0"  fill="none" stroke="rgba(255,255,255,.42)" stroke-width="2.4" stroke-linejoin="round"/>
      <!-- inner top highlight -->
      <path d="M2 1.5 H551" fill="none" stroke="rgba(255,255,255,.34)" stroke-width="3"/>
    </g>

    <!-- outer edge -->
    <rect x=".9" y=".9" width="551.2" height="353.2" rx="15.2" ry="15.2" fill="none" stroke="url(#edge)" stroke-width="1.8"/>

    <!-- ══ BADGE ═══════════════════════════════════════════════════════════
         Centre (404,113). Outer bezel edge r=74.5, bezel 66.5→74.5,
         bright inner rim 64.4→66.4, face r=64.4, "0" = the old rx22/ry33
         stroke-width-9 ellipse rebuilt as an even-odd ring so it can carry a
         real bevel: outer 26.5×37.5, inner 17.5×28.5. Geometry unchanged. -->
    <g class="badge">

      <!-- contact shadow onto the envelope, biased down and slightly left -->
      <circle cx="401.5" cy="119" r="74.5" fill="#000000" opacity=".55" filter="url(#izBlurContact)"/>
      <circle cx="402.5" cy="115.5" r="74.5" fill="#000000" opacity=".45" filter="url(#izBlurContactTight)"/>

      <!-- outer bezel: near-black gloss, not a uniform stroke -->
      <circle cx="404" cy="113" r="74.5" fill="url(#izBezel)"/>
      <!-- bright thin arc, inner shoulder, top-left -->
      <path d="M341.65 83.92A68.8 68.8 0 0 1 466.35 83.92" fill="none"
            stroke="url(#izGlossTL)" stroke-width="2.8" stroke-linecap="round"/>
      <!-- fainter arc, outer shoulder, bottom-right -->
      <path d="M473.16 138.17A73.6 73.6 0 0 0 334.84 138.17" fill="none"
            stroke="url(#izGlossBR)" stroke-width="1.7" stroke-linecap="round"/>

      <!-- face -->
      <circle cx="404" cy="113" r="64.4" fill="url(#izFace)"/>
      <g clip-path="url(#izFaceClip)">
        <ellipse cx="404" cy="113" rx="66" ry="21" transform="rotate(-40 404 113)"
                 fill="url(#izSheen)" filter="url(#izBlurS)"/>
      </g>

      <!-- ══ AURA ══ the "0" glowing into the black face.
           Three stacked blurred copies of the ring, all filled with the same
           top-lit gradient so the light keeps the key direction, all clipped to
           the face; the bright inner rim drawn afterwards hides the clip edge.
           A fourth, much wider copy escapes past the bezel at the very end. -->
      <g clip-path="url(#izFaceClip)">
        <path fill-rule="evenodd" fill="url(#izGlow)" opacity=".30" filter="url(#izBlurM)"
              d="M377.5 113A26.5 37.5 0 1 0 430.5 113A26.5 37.5 0 1 0 377.5 113ZM386.5 113A17.5 28.5 0 1 0 421.5 113A17.5 28.5 0 1 0 386.5 113Z"/>
        <path fill-rule="evenodd" fill="url(#izGlow)" opacity=".52" filter="url(#izBlurS)"
              d="M377.5 113A26.5 37.5 0 1 0 430.5 113A26.5 37.5 0 1 0 377.5 113ZM386.5 113A17.5 28.5 0 1 0 421.5 113A17.5 28.5 0 1 0 386.5 113Z"/>
        <path fill-rule="evenodd" fill="url(#izGlow)" opacity=".45" filter="url(#izBlurXS)"
              d="M377.5 113A26.5 37.5 0 1 0 430.5 113A26.5 37.5 0 1 0 377.5 113ZM386.5 113A17.5 28.5 0 1 0 421.5 113A17.5 28.5 0 1 0 386.5 113Z"/>
      </g>

      <!-- groove between face and rim, then the rim itself -->
      <circle cx="404" cy="113" r="63.9" fill="none" stroke="#000000" stroke-opacity=".7" stroke-width="1.4"/>
      <circle cx="404" cy="113" r="65.4" fill="none" stroke="url(#izRim)" stroke-width="2"/>
      <path d="M468.41 124.36A65.4 65.4 0 0 1 426.37 174.46" fill="none"
            stroke="url(#izRimBR)" stroke-width="2" stroke-linecap="round"/>

      <!-- ══ the "0" ══ -->
      <g clip-path="url(#izZeroClip)">
        <path fill-rule="evenodd" fill="url(#izChrome)"
              d="M377.5 113A26.5 37.5 0 1 0 430.5 113A26.5 37.5 0 1 0 377.5 113ZM386.5 113A17.5 28.5 0 1 0 421.5 113A17.5 28.5 0 1 0 386.5 113Z"/>
        <g filter="url(#izBlurXS)">
          <!-- bright outer edge: only the inner half of this stroke survives the clip -->
          <ellipse cx="404" cy="113" rx="26.5" ry="37.5" fill="none"
                   stroke="url(#izBevelOut)" stroke-width="6.4"/>
          <!-- darker inner edge, lit from the left -->
          <ellipse cx="404" cy="113" rx="17.5" ry="28.5" fill="none"
                   stroke="url(#izBevelIn)" stroke-width="5.4"/>
          <!-- second highlight, bottom-right -->
          <path d="M428.9 125.83A26.5 37.5 0 0 1 412.19 148.66" fill="none"
                stroke="url(#izSpecBR)" stroke-width="5" stroke-linecap="round"/>
        </g>
      </g>
      <!-- dark contour straddling both boundaries: the measured hairline that
           separates the chrome from the face and from the hole -->
      <path fill="none" stroke="#000000" stroke-opacity=".72" stroke-width="1.9" filter="url(#izBlurXS)"
            d="M377.5 113A26.5 37.5 0 1 0 430.5 113A26.5 37.5 0 1 0 377.5 113ZM386.5 113A17.5 28.5 0 1 0 421.5 113A17.5 28.5 0 1 0 386.5 113Z"/>

      <!-- small soft dot dead centre, with its own bloom -->
      <circle cx="404" cy="113" r="5.2" fill="#e8eef2" opacity=".38" filter="url(#izBlurS)"/>
      <circle cx="404" cy="113" r="6.4" fill="url(#izDot)"/>

      <!-- ══ escape glow ══ the only layer allowed past the bezel: a wide, very
           soft copy of the ring drawn over everything, so the badge reads as
           actually emitting light onto the envelope. -->
      <path fill-rule="evenodd" fill="url(#izGlow)" opacity=".15" filter="url(#izBlurL)"
            d="M377.5 113A26.5 37.5 0 1 0 430.5 113A26.5 37.5 0 1 0 377.5 113ZM386.5 113A17.5 28.5 0 1 0 421.5 113A17.5 28.5 0 1 0 386.5 113Z"/>
    </g>
  </svg>

  <form class="bar" id="bar" novalidate>
    <input id="email" type="email" name="email" placeholder="Enter your email" autocomplete="email" required aria-label="Enter your email">
    <button type="submit">Join waitlist</button>
  </form>

</main>

<script>
  const bar = document.getElementById('bar');
  const email = document.getElementById('email');

  bar.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = email.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)) {
      email.focus();
      bar.animate(
        [{transform:'translateX(0)'},{transform:'translateX(-6px)'},{transform:'translateX(6px)'},{transform:'translateX(0)'}],
        {duration:260, easing:'ease-in-out'}
      );
      return;
    }
    bar.classList.add('is-done');
    bar.innerHTML = '<span class="done">You’re on the list.</span>';
  });
</script>

</body>
</html>
